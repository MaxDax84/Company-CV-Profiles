# Gmail SMTP configuration (for the contact form)
#
# Setup instructions:
# 1. Go to your Google Account > Security
# 2. Enable 2-Step Verification (required)
# 3. Search for "App Passwords" and create one for "Mail"
# 4. Paste the 16-character password below (no spaces)
#
# Then rename this file to .env.local

GMAIL_USER=massimo.dassano@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Vercel KV (Redis) — ottieni questi valori da: vercel.com → Storage → crea KV → .env.local
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
KV_REST_API_READ_ONLY_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile (anti-bot check on the resume upload) — ottieni queste
# chiavi da: dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# Optional — comma-separated hostnames the "paste an existing profile link"
# feature on /tailor accepts. Defaults to company-cv-profiles.vercel.app if
# unset. Add a custom domain here if/when one is bought (see the domain
# change checklist).
# ALLOWED_PROFILE_HOSTS=company-cv-profiles.vercel.app,yourcustomdomain.com
