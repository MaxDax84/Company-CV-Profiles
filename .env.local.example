# Gmail SMTP configuration (for the contact form)
#
# Setup instructions:
# 1. Go to your Google Account > Security
# 2. Enable 2-Step Verification (required)
# 3. Search for "App Passwords" and create one for "Mail"
# 4. Paste the 16-character password below (no spaces)
#
# Then rename this file to .env.local

GMAIL_USER=massimo.dassano@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Vercel KV (Redis) — ottieni questi valori da: vercel.com → Storage → crea KV → .env.local
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
KV_REST_API_READ_ONLY_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile (anti-bot check on the resume upload) — ottieni queste
# chiavi da: dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# Supabase (account system: auth + profiles + credits) — crea un progetto su
# supabase.com, poi Project Settings → API per URL/anon key, e Project
# Settings → API → service_role per la service role key (NON esporla mai al
# client). Dopo aver creato il progetto esegui supabase/migrations/0001_init.sql
# nell'SQL editor. Ricorda anche di disattivare "Confirm email" in
# Authentication → Providers → Email per il flusso di claim sincrono.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 (optional) — only loads once a visitor has actively
# accepted the "Analytics" cookie category in the site's cookie banner (see
# components/google-analytics.tsx). Get the Measurement ID from
# analytics.google.com → Admin → Data Streams → your web stream. Leave unset
# and the cookie banner still works, GA is just never loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin dashboard (/admin/costs — Claude API cost stats) — pick your own
# strong password, it's the only thing gating that page.
ADMIN_PASSWORD=choose-a-strong-password
